# Copy what you need into the app's Secrets box on Streamlit Community Cloud (or .streamlit/secrets.toml locally,
# which is git-ignored). Never commit real values.

# ---------------------------------------------------------------- quickest start: demo mode (NOT authentication)
# [ppaguard]
# demo_mode = true          # synthetic personas on a separate local database; anyone with the link can pick any role

# ---------------------------------------------------------------- production
# Persistent database (e.g. Neon Free PostgreSQL). Without it a local SQLite file is used, which Streamlit Community
# Cloud loses whenever the app restarts. Use a NEW database (the v4 schema is refused).
PPAGUARD_DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Engine 2 model. Default (nothing set): protectai/deberta-v3-base-prompt-injection-v2, ~740 MB download on first
# start, labelled EXPERIMENTAL (see docs/v5/EVALUATION.md). Bundled experimental alternatives, no download:
# PPAGUARD_MODEL = "roberta-6l-experimental"   # or "scratch-baseline"
# PPAGUARD_MODEL_DIR = "/path/to/artifact" # any folder with model_card.json + model.onnx + tokenizer.json

[ppaguard]
# First deployment only: creates this organization and makes this address its first Platform Administrator.
bootstrap_admin_email = "you@your-company.com"
bootstrap_org_name = "Your Company"
bootstrap_industry = "software_it"        # general | software_it | healthcare | finance
# Microsoft sign-in is accepted only from these Entra ID tenants (Directory/tenant ID GUIDs), because the e-mail claim
# of a Microsoft account is not verified by Microsoft in general.
microsoft_tenant_ids = ["00000000-0000-0000-0000-000000000000"]

# Sign-in with Streamlit's built-in OpenID Connect (Authlib is in requirements.txt).
[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"
cookie_secret = "a long random string, e.g. python -c \"import secrets; print(secrets.token_urlsafe(48))\""

[auth.google]
client_id = "....apps.googleusercontent.com"
client_secret = "..."
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

[auth.microsoft]
client_id = "..."
client_secret = "..."
server_metadata_url = "https://login.microsoftonline.com/<TENANT_ID>/v2.0/.well-known/openid-configuration"
